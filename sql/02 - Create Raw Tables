
USE WAREHOUSE SNOWFLAKE_LEARNING_WH;
USE DATABASE RETAIL_ANALYTICS;
USE SCHEMA RAW;

CREATE TABLE IF NOT EXISTS CUSTOMERS (
    CUSTOMER_ID VARCHAR,
    CUSTOMER_NAME VARCHAR,
    EMAIL VARCHAR,
    CITY VARCHAR,
    SEGMENT VARCHAR,
    UPDATED_AT VARCHAR
);

CREATE TABLE IF NOT EXISTS PRODUCTS (
    PRODUCT_ID VARCHAR,
    PRODUCT_NAME VARCHAR,
    CATEGORY VARCHAR,
    UNIT_PRICE VARCHAR
);

CREATE TABLE IF NOT EXISTS ORDERS (
    ORDER_LINE_ID VARCHAR,
    ORDER_ID VARCHAR,
    CUSTOMER_ID VARCHAR,
    PRODUCT_ID VARCHAR,
    ORDER_DATE VARCHAR,
    QUANTITY VARCHAR,
    UNIT_PRICE VARCHAR,
    STATUS VARCHAR,
    UPDATED_AT VARCHAR,
    LOADED_AT VARCHAR
);

